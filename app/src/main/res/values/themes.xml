<resources>
    <style name="Theme.LifeMining" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/green</item>
        <item name="colorAccent">@color/green_light</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
    </style>

    <style name="Theme.LifeMining.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/white_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.LifeMining</item>
    </style>
</resources>
